pipeline {
  agent none 

  stages {
    stage("build") {
      agent {
        docker {
            image 'node:22-alpine'
        }
      }

      when {
        changeset "**/result/**"
      }

      steps {
        echo 'Compiling ...'

        dir('result') {
          sh 'npm install'
        }
      }
    }

    stage("test") {

      agent {
        docker {
            image 'node:22-alpine'
        }
      }
      when {
        changeset "**/result/**"
      }

      steps {
        echo 'Testing ...'

        dir('result') {
          sh 'npm install'
          sh 'npm test'
        }
      }
    }
  }
}