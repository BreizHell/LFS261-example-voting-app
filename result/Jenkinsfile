pipeline {
  agent {
    docker {
        image 'node:22-alpine'
    }
  }

  stages {
    stage("build") {
      when {
        changeset "**/result/**"
      }

      steps {
        echo 'Compiling ...'

        dir('result') {
          sh 'npm install'
        }
      }
    }

    stage("test") {
      when {
        changeset "**/result/**"
      }

      steps {
        echo 'Testing ...'

        dir('result') {
          sh 'npm install'
          sh 'npm test'
        }
      }
    }
  }
}